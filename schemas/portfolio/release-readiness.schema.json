    },
    "cloud_deployed": {
      "default": false,
      "title": "Cloud Deployed",
      "type": "boolean"
    },
    "conditional_gate_count": {
      "title": "Conditional Gate Count",
      "type": "integer"
    },
    "coverage": {
      "title": "Coverage",
      "type": "number"
    },
    "failed_required_gates": {
      "title": "Failed Required Gates",
      "type": "integer"

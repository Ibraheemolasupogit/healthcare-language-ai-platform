      "$ref": "#/$defs/RetrievalRunStatus"
    },
    "section_count": {
      "title": "Section Count",
      "type": "integer"
    },
    "sentence_count": {
      "title": "Sentence Count",
      "type": "integer"
    },
    "source_extraction_manifest_checksum": {
      "title": "Source Extraction Manifest Checksum",
      "type": "string"
    },
    "source_extraction_run_id": {
      "title": "Source Extraction Run Id",
      "type": "string"
    },
    "source_preprocessing_manifest_checksum": {
      "title": "Source Preprocessing Manifest Checksum",
      "type": "string"
    },
    "source_preprocessing_run_id": {
      "title": "Source Preprocessing Run Id",
      "type": "string"
    },
    "synthetic_data_only": {
      "title": "Synthetic Data Only",
      "type": "boolean"
    },
    "text_representation": {

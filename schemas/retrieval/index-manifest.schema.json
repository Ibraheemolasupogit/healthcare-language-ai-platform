      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bm25_version": {
      "title": "Bm25 Version",
      "type": "string"
    },
    "clinical_use_prohibited": {
      "title": "Clinical Use Prohibited",
      "type": "boolean"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "document_count": {
      "title": "Document Count",
      "type": "integer"
    },
    "embedding_dimension": {
      "title": "Embedding Dimension",
      "type": "integer"
    },
    "embedding_provider": {
      "$ref": "#/$defs/EmbeddingProvider"
    },
    "hash_embedding_version": {
      "title": "Hash Embedding Version",
      "type": "string"
    },
    "hybrid_version": {
      "title": "Hybrid Version",
      "type": "string"
    },
    "index_id": {
      "title": "Index Id",
      "type": "string"
    },
    "index_strategies": {
      "items": {
        "type": "string"
      },
      "title": "Index Strategies",
      "type": "array"
    },
    "keyword_version": {
      "title": "Keyword Version",
      "type": "string"
    },
    "manifest_schema_version": {
      "title": "Manifest Schema Version",
      "type": "string"
    },
    "output_file_checksums": {

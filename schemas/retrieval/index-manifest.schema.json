    },
    "tokeniser_version": {
      "title": "Tokeniser Version",
      "type": "string"
    },
    "unit_types": {
      "items": {
        "type": "string"
      },
      "title": "Unit Types",
      "type": "array"
    },
    "vocabulary_size": {
      "title": "Vocabulary Size",
      "type": "integer"
    },
    "writer_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Writer Versions",
      "type": "object"
    }

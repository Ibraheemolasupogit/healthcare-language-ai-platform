    "text_representation",
    "retrieval_unit_count",
    "document_count",
    "section_count",
    "sentence_count",
    "token_count",
    "vocabulary_size",
    "index_strategies",
    "embedding_provider",
    "embedding_dimension",
    "tokeniser_version",
    "keyword_version",
    "tfidf_version",
    "bm25_version",
    "hash_embedding_version",
    "hybrid_version",
    "reference_timestamp",
    "writer_versions",
    "output_files",
    "output_file_checksums",
    "synthetic_data_only",
    "clinical_use_prohibited",
    "reconciliation_status"
  ],
  "title": "IndexManifest",
  "type": "object"
}

{
  "$defs": {
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "warning",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_label_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Annotation Label Counts",
      "type": "object"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ValidationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "clinical_use_prohibited": {
      "title": "Clinical Use Prohibited",
      "type": "boolean"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "document_type_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Document Type Counts",
      "type": "object"
    },
    "record_count": {
      "title": "Record Count",
      "type": "integer"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic_data_only": {
      "title": "Synthetic Data Only",
      "type": "boolean"
    },
    "validation_status": {
      "enum": [
        "passed",
        "warning",
        "failed"
      ],
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "dataset_name",
    "schema_version",
    "validation_status",
    "checks",
    "record_count",
    "document_type_counts",
    "annotation_label_counts",
    "synthetic_data_only",
    "clinical_use_prohibited"
  ],
  "title": "DataQualityReport",
  "type": "object"
}

{
  "$defs": {
    "ClinicalDocumentType": {
      "description": "Supported synthetic clinical document categories.",
      "enum": [
        "clinical_note",
        "discharge_summary",
        "referral_letter",
        "radiology_report",
        "pathology_report"
      ],
      "title": "ClinicalDocumentType",
      "type": "string"
    },
    "EvaluationSettings": {
      "description": "Settings for deterministic local baseline evaluation.",
      "properties": {
        "context_window_characters": {
          "default": 32,
          "maximum": 200,
          "minimum": 0,
          "title": "Context Window Characters",
          "type": "integer"

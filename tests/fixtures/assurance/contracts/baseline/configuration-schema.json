            "exact",
            "exact_normalised_value",
            "relaxed_overlap"
          ],
          "title": "Default Matching Policy",
          "type": "string"
        },
        "default_output_root": {
          "default": "outputs/evaluation",
          "format": "path",
          "title": "Default Output Root",
          "type": "string"
        },
        "default_overwrite_policy": {
          "default": "fail_if_exists",
